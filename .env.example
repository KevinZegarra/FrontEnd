# ==============================================================================
# FlightTracker Frontend - Plantilla de Variables de Entorno (.env.example)
# ==============================================================================
# Copia este archivo a '.env' o '.env.local' y ajusta los valores según tu entorno:
# cp .env.example .env.local

# Feature Toggle para activar Mocks (true) o API Backend Real (false)
VITE_USE_MOCKS=true

# Endpoint base de la API REST
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Metadatos de la Aplicación
VITE_APP_NAME=FlightTracker
VITE_APP_VERSION=0.1.0
